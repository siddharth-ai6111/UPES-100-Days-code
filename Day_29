
Q57. Find Sum of Array Elements

CODE:
#include <stdio.h>

int main() {
    int a[100], n, i, sum = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        sum = sum + a[i];
    }

    printf("Sum = %d\n", sum);
    return 0;
}

SAMPLE OUTPUT:
Enter number of elements: 5
Enter elements: 1 2 3 4 5
Sum = 15


Q58. Find Maximum and Minimum Element in an Array

CODE:
#include <stdio.h>

int main() {
    int a[100], n, i, max, min;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid size\n");
        return 0;
    }

    printf("Enter elements: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    max = min = a[0];

    for (i = 1; i < n; i++) {
        if (a[i] > max)
            max = a[i];
        if (a[i] < min)
            min = a[i];
    }

    printf("Maximum = %d\n", max);
    printf("Minimum = %d\n", min);

    return 0;
}

SAMPLE OUTPUT:
Enter number of elements: 5
Enter elements: 8 3 15 1 9
Maximum = 15
Minimum = 1
