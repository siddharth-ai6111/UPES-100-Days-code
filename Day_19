
Q37. Find LCM of Two Numbers

CODE:
#include <stdio.h>

int main() {
    int a, b, x, y, temp, gcd, lcm;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    if (a == 0 || b == 0) {
        printf("LCM = 0\n");
        return 0;
    }

    x = a;
    y = b;
    if (x < 0) x = -x;
    if (y < 0) y = -y;

    while (y != 0) {
        temp = y;
        y = x % y;
        x = temp;
    }

    gcd = x;
    lcm = (a / gcd) * b;
    if (lcm < 0) lcm = -lcm;

    printf("LCM = %d\n", lcm);
    return 0;
}

SAMPLE OUTPUT:
Enter two numbers: 12 18
LCM = 36


Q38. Find Sum of Digits

CODE:
#include <stdio.h>

int main() {
    int n, digit, sum = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    if (n < 0) n = -n;

    while (n != 0) {
        digit = n % 10;
        sum = sum + digit;
        n = n / 10;
    }

    printf("Sum of Digits = %d\n", sum);
    return 0;
}

SAMPLE OUTPUT:
Enter a number: 12345
Sum of Digits = 15
